# CubeSandbox single-host online deployment overrides.
# Copy this file outside the skill directory, edit only required values, then run:
#   bash scripts/deploy.sh --env /secure/path/deployment.env

# Release selection. "latest" uses the newest stable GitHub release.
CUBE_VERSION=latest

# cn: download the same release asset from CNB and use CN container images.
# Empty: download from GitHub and use the global container registry defaults.
MIRROR=cn

# Multi-NIC hosts should set this explicitly after user confirmation.
# When empty, deploy.sh selects the IPv4 address on the default-route interface.
CUBE_SANDBOX_NODE_IP=

# auto: use PVM only when an x86_64 PVM host/kernel is detected.
# 0: ordinary guest kernel for native KVM. 1: PVM guest kernel (x86_64 only).
CUBE_PVM_ENABLE=auto

# Set only when the official default 192.168.0.0/18 conflicts with the host/VPN.
# Must be a private IPv4 network with a /16 through /24 mask.
# CUBE_SANDBOX_NETWORK_CIDR=10.100.0.0/18

# Optional supply-chain override for a user-approved release mirror.
# The filename must end in -amd64.tar.gz or -arm64.tar.gz to match the host.
# Always provide the independently verified digest for a custom source.
# CUBE_SANDBOX_DOWNLOAD_URL=https://mirror.example.com/cube-sandbox-one-click-vX.Y.Z-amd64.tar.gz
# CUBE_SANDBOX_SHA256=replace_with_the_verified_64_hex_character_digest

# If the network requires a proxy, obtain the exact values from the user.
# Do not put credentials directly in this repository or in shell history.
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=127.0.0.1,localhost

# Additional official settings (external databases, private image registries,
# credentials, ports, DNS mode, etc.) can be added as fresh-install overrides.
# Specify only intentional changes; this skill does not upgrade existing installs.
