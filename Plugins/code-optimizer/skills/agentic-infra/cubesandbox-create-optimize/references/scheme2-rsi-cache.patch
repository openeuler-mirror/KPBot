+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+package sandboxspec
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/base/constants"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/base/db/models"
+	"github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/base/log"
+	sandboxtypes "github.com/tencentcloud/CubeSandbox/CubeMaster/pkg/service/sandbox/types"
+)
+
+const (
+	asyncPutQueueSize = 512
+	asyncPutWorkers   = 2
+	// The worker's gate wait and all retry attempts share this deadline;
+	// time spent waiting in the queue is not part of it.
+	asyncPutTimeout = 10 * time.Second
+	asyncPutRetries = 3
+)
+
+// specWriteState belongs to one sandbox ID in this process. Its reference
+// count includes queued items and waiting/in-flight operations, so it cannot
+// expire while an old write is still capable of running.
+type specWriteState struct {
+	id         string
+	permit     chan struct{}
+	generation uint64 // protected by permit
+	refs       int    // protected by specWriteStatesMu
+}
+
+type asyncPutItem struct {
+	rec        *models.SandboxSpec
+	state      *specWriteState
+	generation uint64
+}
+
+var (
+	asyncPutOnce  sync.Once
+	asyncPutQueue chan asyncPutItem
+
+	specWriteStatesMu sync.Mutex
+	specWriteStates   = make(map[string]*specWriteState)
+)
+
+func retainSpecWriteState(id string) *specWriteState {
+	specWriteStatesMu.Lock()
+	defer specWriteStatesMu.Unlock()
+	state := specWriteStates[id]
+	if state == nil {
+		state = &specWriteState{id: id, permit: make(chan struct{}, 1)}
+		state.permit <- struct{}{}
+		specWriteStates[id] = state
+	}
+	state.refs++
+	return state
+}
+
+func releaseSpecWriteState(state *specWriteState) {
+	specWriteStatesMu.Lock()
+	defer specWriteStatesMu.Unlock()
+	state.refs--
+	if state.refs == 0 && specWriteStates[state.id] == state {
+		delete(specWriteStates, state.id)
+	}
+}
+
+func (state *specWriteState) lock(ctx context.Context) error {
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-state.permit:
+		if err := ctx.Err(); err != nil {
+			state.unlock()
+			return err
+		}
+		return nil
+	}
+}
+
+func (state *specWriteState) unlock() {
+	state.permit <- struct{}{}
+}
+
+// withSpecWrite linearizes a newer write/delete against all queued and
+// in-flight writes for this ID. The permit is held across the actual DB call.
+// This is a process-local protocol; other masters need database fencing.
+func withSpecWrite(ctx context.Context, id string, operation func() error) error {
+	state := retainSpecWriteState(id)
+	defer releaseSpecWriteState(state)
+	if err := state.lock(ctx); err != nil {
+		return err
+	}
+	defer state.unlock()
+	state.generation++
+	return operation()
+}
+
+func writeRecordOrdered(ctx context.Context, rec *models.SandboxSpec) error {
+	return withSpecWrite(ctx, rec.SandboxID, func() error { return upsertRecord(ctx, rec) })
+}
+
+func deleteRecordOrdered(ctx context.Context, id string) error {
+	return withSpecWrite(ctx, id, func() error { return deleteRecord(ctx, id) })
+}
+
+func startAsyncPutWorkers() {
+	asyncPutOnce.Do(func() {
+		asyncPutQueue = make(chan asyncPutItem, asyncPutQueueSize)
+		for i := 0; i < asyncPutWorkers; i++ {
+			go asyncPutWorker()
+		}
+	})
+}
+
+// PutAsync materializes an independent record on the caller goroutine and
+// hands it to a bounded queue. A full queue falls back to an ordered synchronous
+// write; an uninitialized store returns its explicit error. Persistence remains
+// best-effort, so callers must preserve their existing failure reporting.
+func PutAsync(ctx context.Context, sandboxID string, req *sandboxtypes.CreateCubeSandboxReq, opts PutOptions) error {
+	rec, err := buildRecord(sandboxID, req, opts)
+	if err != nil {
+		recordPersistFailure(persistFailureReason(err))
+		return err
+	}
+	if !IsReady() {
+		recordPersistFailure(persistFailureReason(ErrSandboxSpecStoreNotReady))
+		return ErrSandboxSpecStoreNotReady
+	}
+	startAsyncPutWorkers()
+	state := retainSpecWriteState(rec.SandboxID)
+	if err := state.lock(ctx); err != nil {
+		releaseSpecWriteState(state)
+		recordPersistFailure(persistFailureReason(err))
+		return err
+	}
+	queued := false
+	defer func() {
+		state.unlock()
+		if !queued {
+			releaseSpecWriteState(state)
+		}
+	}()
+	state.generation++
+	item := asyncPutItem{rec: rec, state: state, generation: state.generation}
+	select {
+	case asyncPutQueue <- item:
+		// Transfer this reference to the worker, which releases it even when
+		// the item has been superseded before its turn.
+		queued = true
+		return nil
+	default:
+		if err := upsertRecord(ctx, rec); err != nil {
+			recordPersistFailure(persistFailureReason(err))
+			return err
+		}
+		return nil
+	}
+}
+
+func asyncPutWorker() {
+	for item := range asyncPutQueue {
+		if err := persistAsyncPutItem(item); err != nil {
+			recordPersistFailure(persistFailureReason(err))
+			log.G(context.Background()).Warnf("async persist sandbox spec failed sandbox=%s: %v", item.rec.SandboxID, err)
+		}
+	}
+}
+
+func persistAsyncPutItem(item asyncPutItem) error {
+	if item.state == nil {
+		return nil
+	}
+	defer releaseSpecWriteState(item.state)
+	if item.rec == nil {
+		return nil
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), asyncPutTimeout)
+	defer cancel()
+	if err := item.state.lock(ctx); err != nil {
+		return err
+	}
+	defer item.state.unlock()
+	if item.generation != item.state.generation {
+		return nil
+	}
+	var err error
+	for attempt := 1; attempt <= asyncPutRetries; attempt++ {
+		err = upsertRecord(ctx, item.rec)
+		if err == nil || attempt == asyncPutRetries || ctx.Err() != nil {
+			return err
+		}
+		select {
+		case <-time.After(time.Duration(attempt) * 50 * time.Millisecond):
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+	}
+	return err
+}
+
+func deleteRecord(ctx context.Context, sandboxID string) error {
+	client := getDB()
+	if client == nil {
+		return ErrSandboxSpecStoreNotReady
+	}
+	return client.WithContext(ctx).Table(constants.SandboxSpecTableName).
+		Where("sandbox_id = ?", sandboxID).
+		Delete(&models.SandboxSpec{}).Error
+}
