{
  "schema_version": "1.0",
  "source": "鲲鹏BoostKit分布式存储使能套件 Ceph编译&部署&调优&测试指南 文档版本07(2025-06-30) 第9.3.3节(系统调优)与第9.3.4节(Ceph调优)，Ceph块存储调优指南",
  "usage": "体检时逐项读取 current 值与 suggested 比对形成 gap；变更仅作为候选动作由主框架执行。persist 字段为重启后保持生效的持久化位置。",
  "ownership": "evidence-only：os_tuning 为只读体检证据（建议值参照指南 9.3.3 表 9-14），候选动作归属 os-optimization（os-playbook 为准）",
  "os_tuning": [
    {
      "param": "vm.swappiness",
      "check_cmd": "sysctl -n vm.swappiness",
      "default": "60",
      "suggested": "0",
      "apply_cmd": "sysctl -w vm.swappiness=0",
      "persist": "/etc/sysctl.d/99-os-optimization.conf（由 os-optimization 统一落盘）",
      "reason": "避免使用 swap 导致性能下降",
      "scope": "全部节点"
    },
    {
      "param": "MTU",
      "check_cmd": "ip addr show <iface>",
      "default": "1500",
      "suggested": "9000",
      "apply_cmd": "/etc/sysconfig/network-scripts/ifcfg-<iface> 增加 MTU=\"9000\" 后 service NetworkManager restart",
      "persist": "ifcfg-<iface> 文件",
      "reason": "减少网络包数量提高效率",
      "scope": "全部节点全部网口",
      "risk_note": "需网络中断窗口，全链路需支持 jumbo frame"
    },
    {
      "param": "kernel.pid_max",
      "check_cmd": "cat /proc/sys/kernel/pid_max",
      "default": "32768",
      "suggested": "4194303",
      "apply_cmd": "echo 4194303 > /proc/sys/kernel/pid_max",
      "persist": "/etc/sysctl.d/99-os-optimization.conf（由 os-optimization 统一落盘）",
      "reason": "重量级任务下默认值不够用导致内存分配失败",
      "scope": "全部节点"
    },
    {
      "param": "fs.file-max",
      "check_cmd": "cat /proc/sys/fs/file-max",
      "default": "系统自算",
      "suggested": "$(cat /proc/meminfo | grep MemTotal | awk '{print $2}')",
      "apply_cmd": "echo <MemTotal值> > /proc/sys/fs/file-max",
      "persist": "/etc/sysctl.d/99-os-optimization.conf（由 os-optimization 统一落盘）",
      "reason": "避免文件句柄耗尽",
      "scope": "全部节点"
    },
    {
      "param": "read_ahead",
      "check_cmd": "/sbin/blockdev --getra <dev>",
      "default": "128KB",
      "suggested": "8192KB",
      "apply_cmd": "/sbin/blockdev --setra 8192 <dev>",
      "persist": "udev rules / tuned / rc-local",
      "reason": "减少磁盘寻道次数与 IO 等待",
      "scope": "所有数据盘"
    },
    {
      "param": "io_scheduler",
      "check_cmd": "cat /sys/block/<dev>/queue/scheduler",
      "default": "发行版默认",
      "suggested": "HDD=deadline; SSD/NVMe=none",
      "apply_cmd": "echo deadline > /sys/block/<dev>/queue/scheduler; echo none > /sys/class/block/<nvme_dev>/queue/scheduler",
      "persist": "udev rules / tuned",
      "reason": "按存储介质选择调度器优化性能",
      "scope": "所有数据盘"
    },
    {
      "param": "nr_requests",
      "check_cmd": "cat /sys/block/<dev>/queue/nr_requests",
      "default": "128（SSD 默认 1023）",
      "suggested": "HDD=512; SSD/NVMe=1023",
      "apply_cmd": "echo 512 > /sys/block/<dev>/queue/nr_requests; echo 1023 > /sys/block/<nvme_dev>/queue/nr_requests",
      "persist": "udev rules / tuned / rc-local",
      "reason": "提升磁盘吞吐量",
      "scope": "所有数据盘"
    }
  ],
  "numa_affinity": {
    "purpose": "确认网络和存储资源在各 NUMA 节点间均衡分布（只读体检证据）",
    "check_cmd": "cat /sys/block/nvme*/device/numa_node; cat /sys/class/net/*/device/numa_node",
    "handoff": "分布不均衡写入 os_tuning_findings[]（不生成动作）；绑核与 IRQ 亲和动作交 cpu-affinity-optimization / network-optimization",
    "note": "设备 numa_node 由 PCIe 拓扑决定，sysfs 属性为只读，写入不可行也不会迁移设备"
  },
  "ceph_conf": {
    "apply_method": "修改 /etc/ceph/ceph.conf 后 systemctl restart ceph.target；仅当前节点生效，需应用到全部 Ceph 节点。cephadm/容器部署用 ceph config set <section> <key> <value> 等价映射",
    "restart": "systemctl restart ceph.target",
    "backup": "cp /etc/ceph/ceph.conf{,.bak.<run_id>}",
    "global": [
      {
        "param": "osd_pool_default_min_size",
        "default": "0",
        "suggested": "1",
        "reason": "min_size 是 PG 能接受 IO 的最小副本数"
      },
      {
        "param": "cluster_network",
        "default": "空",
        "suggested": "<独立集群网段，如 192.168.4.0/24>",
        "reason": "OSD 间副本复制/数据均衡走独立网段，缓解 public network 压力"
      },
      {
        "param": "osd_pool_default_size",
        "default": "3",
        "suggested": "3",
        "reason": "副本数保持 3；变更副本数属数据迁移风险动作"
      },
      {
        "param": "mon_max_pg_per_osd",
        "default": "250",
        "suggested": "3000",
        "reason": "调大 PG 告警阈值"
      },
      {
        "param": "mon_max_pool_pg_num",
        "default": "65536",
        "suggested": "300000",
        "reason": "调大 PG 告警阈值"
      },
      {
        "param": "debug_*（全量开关）",
        "default": "非 0",
        "suggested": "0/0",
        "reason": "关闭 debug 减少日志打印开销",
        "list": [
          "debug_none",
          "debug_lockdep",
          "debug_context",
          "debug_crush",
          "debug_mds",
          "debug_mds_balancer",
          "debug_mds_locker",
          "debug_mds_log",
          "debug_mds_log_expire",
          "debug_mds_migrator",
          "debug_buffer",
          "debug_timer",
          "debug_filer",
          "debug_striper",
          "debug_objecter",
          "debug_rados",
          "debug_rbd",
          "debug_rbd_mirror",
          "debug_rbd_replay",
          "debug_journaler",
          "debug_objectcacher",
          "debug_client",
          "debug_osd",
          "debug_optracker",
          "debug_objclass",
          "debug_filestore",
          "debug_journal",
          "debug_ms",
          "debug_mon",
          "debug_monc",
          "debug_paxos",
          "debug_tp",
          "debug_auth",
          "debug_crypto",
          "debug_finisher",
          "debug_reserver",
          "debug_heartbeatmap",
          "debug_perfcounter",
          "debug_rgw",
          "debug_civetweb",
          "debug_javaclient",
          "debug_asok",
          "debug_throttle",
          "debug_refs",
          "debug_xio",
          "debug_compressor",
          "debug_bluestore",
          "debug_bluefs",
          "debug_bdev",
          "debug_kstore",
          "debug_rocksdb",
          "debug_leveldb",
          "debug_memdb",
          "debug_kinetic",
          "debug_fuse",
          "debug_mgr",
          "debug_mgrc",
          "debug_dpdk",
          "debug_eventtrace"
        ]
      },
      {
        "param": "throttler_perf_counter",
        "default": "True",
        "suggested": "False",
        "reason": "默认开启用于观察阈值是否达到瓶颈，性能调到最佳后建议关闭，tracker 影响性能"
      },
      {
        "param": "ms_dispatch_throttle_bytes",
        "default": "104857600",
        "suggested": "2097152000",
        "reason": "等待调度的最大消息数调大，提高消息处理效率"
      },
      {
        "param": "ms_bind_before_connect",
        "default": "False",
        "suggested": "True",
        "reason": "消息队列绑定，保证多网口流量均衡"
      }
    ],
    "client": [
      {
        "param": "rbd_cache",
        "default": "True",
        "suggested": "False",
        "reason": "关闭客户端 cache，关闭后 rbd cache 一直是 writethrough 模式"
      }
    ],
    "osd": [
      {
        "param": "osd_max_write_size",
        "default": "90",
        "suggested": "256",
        "reason": "OSD 一次可写入的最大值（MB）"
      },
      {
        "param": "osd_client_message_size_cap",
        "default": "524288000",
        "suggested": "1073741824",
        "reason": "客户端允许在内存中的最大数据（Bytes）"
      },
      {
        "param": "osd_map_cache_size",
        "default": "50",
        "suggested": "1024",
        "reason": "保留 OSD Map 的缓存（MB）"
      },
      {
        "param": "bluestore_rocksdb_options",
        "default": "compression=kNoCompression,max_write_buffer_number=4,min_write_buffer_number_to_merge=1,recycle_log_file_num=4,write_buffer_size=268435456,writable_file_max_buffer_size=0,compaction_readahead_size=2097152,max_background_compactions=2",
        "suggested": "compression=kNoCompression,max_write_buffer_number=64,min_write_buffer_number_to_merge=32,recycle_log_file_num=64,compaction_style=kCompactionStyleLevel,write_buffer_size=4MB,target_file_size_base=4MB,max_background_compactions=16,level0_file_num_compaction_trigger=64,level0_slowdown_writes_trigger=128,level0_stop_writes_trigger=256,max_bytes_for_level_base=6GB,compaction_threads=8,flusher_threads=4,compaction_readahead_size=2MB",
        "reason": "rocksdb 配置参数"
      },
      {
        "param": "mon_osd_full_ratio",
        "default": "0.95",
        "suggested": "0.97",
        "reason": "OSD 视为已满的磁盘空间百分比"
      },
      {
        "param": "mon_osd_nearfull_ratio",
        "default": "0.85",
        "suggested": "0.95",
        "reason": "OSD 视为近似满的磁盘空间百分比"
      },
      {
        "param": "osd_min_pg_log_entries",
        "default": "3000",
        "suggested": "10",
        "reason": "PGLog 记录条数下阈值"
      },
      {
        "param": "osd_max_pg_log_entries",
        "default": "3000",
        "suggested": "10",
        "reason": "PGLog 记录条数上阈值"
      },
      {
        "param": "bluestore_cache_meta_ratio",
        "default": "0.4",
        "suggested": "0.8",
        "reason": "bluestore cache 中分配给 meta 的比例"
      },
      {
        "param": "bluestore_cache_kv_ratio",
        "default": "0.4",
        "suggested": "0.2",
        "reason": "bluestore cache 中分配给 kv 的比例"
      }
    ]
  },
  "pg_distribution": {
    "pg_num_formula": "Total PGs = (Total_number_of_OSD * 100) / max_replication_count，结果向上取整到最近的 2 的整数次幂",
    "pgp_num": "与 pg_num 相同",
    "balancer_mode": {
      "default": "none",
      "suggested": "upmap",
      "cmd": "ceph balancer mode upmap; ceph balancer on"
    },
    "observe_cmd": "ceph balancer eval; ceph pg dump",
    "notes": [
      "balancer 开启后每 60 秒自动调整少量 PG 分布",
      "主 PG 也应尽量均匀分布到各 OSD"
    ]
  },
  "osd_binding": {
    "param": "osd_numa_node",
    "config_section": "[osd.n]",
    "suggested": "设置为网卡软中断所属 NUMA 节点之外的空闲 NUMA 节点",
    "check_cmd": "cat /sys/class/net/<iface>/device/numa_node; ceph daemon osd.N config show | grep osd_numa_node",
    "reason": "避免 OSD 进程与网卡中断或其他高 CPU 消耗进程运行在同一 NUMA 节点，网络压力大时避免 CPU 瓶颈"
  }
}
