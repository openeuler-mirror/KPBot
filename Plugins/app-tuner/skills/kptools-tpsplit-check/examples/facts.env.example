# collect_env.sh 输出示例：GLM5.2 W4A8 Prefill 集群（TP32 × 5 DP，160 卡，单卡 64G）
# 复现: python analyze_feasibility.py --facts examples/facts.env.example \
#         --weights-json examples/glm52_weights.json \
#         --total-cards 160 --ep-group 32 --tp-candidates 32,16,8 --out glm52.md
HOST_NAME=prefill-node-01
COLLECT_TIME=2026-11-23 20:00:00
NPU_LOCAL_COUNT=8
NPU0_TOTAL_MB=65536
NPU0_USED_MB=60672
NPU_TOTAL_MB=65536
NPU_USED_MB=60672
# EP_GROUP_SIZE 由采集端按实例 TP×DP 推断输出（本例 32×5=160，vLLM EP 世界口径）；
# 本样例测算演示 --ep-group 32（supernode 单组口径）覆盖，故不落该键
PARAM_SOURCE=script
TP_SIZE=32
DP_SIZE=5
PP_SIZE=1
EP_ENABLED=1
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=131072
KV_CACHE_DTYPE=auto
VLLM_ARGS=vllm serve /data/models/GLM-5.2-W4A8 --tensor-parallel-size 32 --data-parallel-size 5 --enable-expert-parallel --gpu-memory-utilization 0.9 --max-model-len 131072 --kv-cache-dtype auto
MODEL_DIR=/data/models/GLM-5.2-W4A8
CONFIG_EXISTS=1
CONFIG_NUM_HIDDEN_LAYERS=78
CONFIG_KV_LORA_RANK=512
CONFIG_N_ROUTED_EXPERTS=160
CONFIG_HIDDEN_SIZE=7168
SAFETENSORS_COUNT=38
LOG_MODEL_WEIGHTS_GIB=22.00
LOG_AVAILABLE_KV_GIB=27.70
LOG_DESIRED_TOTAL_GIB=54.00
LOG_ACTUAL_TOTAL_GIB=54.00
LOG_KV_TOKENS=331000
