+/*
+ * Rename a snapshot in place. Metadata-only: the snapshot keeps its
+ * origin volume, size and device path; only the name changes. Used by
+ * the pre-derived rootfs pool to hand a pre-built snapshot to a sandbox
+ * without re-running FICLONE. The rename is durable only after
+ * cubecow_fsync_snapshot_dir (or any other fsync of the origin
+ * directory); callers batch that themselves.
+ *
+ * On success writes the snapshot's device path to out_device_path
+ * (owned C string, caller frees with cubecow_free_string). Optional,
+ * can be NULL.
+ */
+int32_t cubecow_rename_snapshot(
+    CubecowEngineHandle engine,
+    const char* old_name,
+    const char* new_name,
+    char** out_device_path);
+
+/*
+ * Best-effort fsync of the directory that holds `name` (resolved via
+ * its origin volume). One call flushes every pending rename/creation
+ * in that directory, enabling batched durability.
+ */
+int32_t cubecow_fsync_snapshot_dir(CubecowEngineHandle engine, const char* name);
+
