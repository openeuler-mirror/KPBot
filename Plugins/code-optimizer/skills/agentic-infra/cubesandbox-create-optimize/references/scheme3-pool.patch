diff --git a/Cubelet/storage/rootfs_pool.go b/Cubelet/storage/rootfs_pool.go
new file mode 100644
index 0000000..3c694ff
--- /dev/null
+++ b/Cubelet/storage/rootfs_pool.go
@@ -0,0 +1,294 @@
+// Copyright (c) 2026 Tencent Inc.
+// SPDX-License-Identifier: Apache-2.0
+//
+
+package storage
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/tencentcloud/CubeSandbox/Cubelet/pkg/cubecow"
+	"github.com/tencentcloud/CubeSandbox/Cubelet/pkg/log"
+)
+
+// Pre-derived sandbox-rootfs shadow pool.
+//
+// Every sandbox create derives its rootfs from the template rootfs with
+// FICLONE followed by an fsync of the shared origin directory. Under a
+// concurrent create burst that per-create fsync serialises on the shared
+// directory and dominates the storage tail. The pool moves the whole
+// derive (FICLONE + fsync) off the create reply path:
+//
+//   - a background worker pre-derives pool members from the immutable
+//     template rootfs, staggered so it never contends with live creates;
+//   - a create pops a member and the engine renames it to the sandbox
+//     rootfs name — a metadata-only operation;
+//   - durability of the renames is batched by a flusher that fsyncs the
+//     origin directory at most once per flush interval;
+//   - any miss falls back to the exact direct-derive path.
+//
+// R1's warm-source split (falsified) kept the per-create derive on the hot
+// path and only rotated FICLONE sources; this pool removes the derive
+// itself. Adopted snapshots are indistinguishable from direct-derived ones
+// in the cubecow index (same origin volume, same directory, same shape),
+// so delete / resize / retry semantics are inherited unchanged.
+
+const (
+	// rootfsPoolDefaultSize covers a c=100 burst of warmup plus measured
+	// rounds with margin, so one measurement invocation never drains the
+	// pool between replenishments. Tunable via CUBELET_ROOTFS_POOL_SIZE.
+	rootfsPoolDefaultSize = 480
+	// rootfsPoolBuildStagger keeps replenishment off the create hot path:
+	// one member per interval, never a parallel build burst (R1 lesson).
+	rootfsPoolBuildStagger = 25 * time.Millisecond
+	// rootfsPoolFlushDelay debounces durability: every adoption inside the
+	// window is flushed by a single directory fsync (cost divided by N).
+	rootfsPoolFlushDelay = 20 * time.Millisecond
+	// rootfsPoolSweepLimit bounds the best-effort cleanup sweep when a
+	// template rootfs is deleted (covers targets larger than the default).
+	rootfsPoolSweepLimit = 2048
+)
+
+// rootfsShadowPool is the per-template-rootfs pre-derived pool state.
+type rootfsShadowPool struct {
+	mu        sync.Mutex
+	source    string
+	target    int
+	present   map[string]bool
+	available []string
+	building  bool
+	closed    bool
+	done      chan struct{}
+	flushCh   chan struct{}
+}
+
+// Package-level pool registry: the storage engine is a per-process
+// singleton, so this keeps XfsCow's own struct unchanged.
+var (
+	rootfsPoolsMu sync.Mutex
+	rootfsPools   = make(map[string]*rootfsShadowPool)
+)
+
+func rootfsPoolMemberName(templateSource string, i int) string {
+	return fmt.Sprintf("%s-pool-%04d", templateSource, i)
+}
+
+// isTemplateRootfsSnapshotName reports whether name is the canonical
+// template rootfs snapshot (tpl-<id>-rootfs), as opposed to a sandbox
+// rootfs (sb-...), a pool member (...-pool-NNNN) or the build volume.
+func isTemplateRootfsSnapshotName(name string) bool {
+	return strings.HasPrefix(name, "tpl-") &&
+		strings.HasSuffix(name, "-rootfs") &&
+		!strings.Contains(name, "-pool-") &&
+		!strings.Contains(name, "-build-")
+}
+
+// rootfsPoolSize resolves the configured pool size (0 = disabled).
+func rootfsPoolSize() int {
+	if v := os.Getenv("CUBELET_ROOTFS_POOL_DISABLE"); v != "" {
+		return 0
+	}
+	if v := os.Getenv("CUBELET_ROOTFS_POOL_SIZE"); v != "" {
+		if n, err := strconv.Atoi(v); err == nil && n > 0 {
+			return n
+		}
+	}
+	return rootfsPoolDefaultSize
+}
+
+// rootfsPoolFor returns the pool for templateSource, creating it (and
+// starting its flusher and first fill) on first use. Returns nil when the
+// pool is disabled.
+func (m *XfsCow) rootfsPoolFor(templateSource string) *rootfsShadowPool {
+	target := rootfsPoolSize()
+	if target == 0 {
+		return nil
+	}
+	rootfsPoolsMu.Lock()
+	pool, ok := rootfsPools[templateSource]
+	if !ok {
+		pool = &rootfsShadowPool{
+			source:  templateSource,
+			target:  target,
+			present: make(map[string]bool),
+			done:    make(chan struct{}),
+			flushCh: make(chan struct{}, 1),
+		}
+		rootfsPools[templateSource] = pool
+		go m.rootfsPoolFlusher(pool)
+	}
+	rootfsPoolsMu.Unlock()
+
+	m.kickRootfsPoolFill(pool)
+	return pool
+}
+
+// kickRootfsPoolFill starts the single staggered builder when the pool is
+// below target and no builder is running.
+func (m *XfsCow) kickRootfsPoolFill(pool *rootfsShadowPool) {
+	pool.mu.Lock()
+	start := !pool.building && !pool.closed && len(pool.available) < pool.target
+	if start {
+		pool.building = true
+	}
+	pool.mu.Unlock()
+	if start {
+		go m.fillRootfsPool(pool)
+	}
+}
+
+// fillRootfsPool pre-derives members one at a time until the pool reaches
+// its target. AlreadyExists means the member survived from a previous
+// process life (orphan recovery) and counts as available.
+func (m *XfsCow) fillRootfsPool(pool *rootfsShadowPool) {
+	for {
+		pool.mu.Lock()
+		if pool.closed || len(pool.available) >= pool.target {
+			pool.building = false
+			pool.mu.Unlock()
+			return
+		}
+		slot := -1
+		for i := 0; i < pool.target; i++ {
+			name := rootfsPoolMemberName(pool.source, i)
+			if !pool.present[name] {
+				slot = i
+				pool.present[name] = true
+				break
+			}
+		}
+		if slot < 0 {
+			pool.building = false
+			pool.mu.Unlock()
+			return
+		}
+		pool.mu.Unlock()
+
+		name := rootfsPoolMemberName(pool.source, slot)
+		if _, err := m.engine.CreateSnapshotFromVolume(pool.source, name, false); err != nil {
+			if !isCowSemantic(err, cubecow.SemAlreadyExists) {
+				log.G(context.Background()).Warnf("rootfs pool fill stop source=%s slot=%d err=%v", pool.source, slot, err)
+				pool.mu.Lock()
+				delete(pool.present, name)
+				pool.building = false
+				pool.mu.Unlock()
+				return
+			}
+		}
+		pool.mu.Lock()
+		pool.available = append(pool.available, name)
+		count := len(pool.available)
+		pool.mu.Unlock()
+		if count == pool.target {
+			log.G(context.Background()).Infof("rootfs pool ready source=%s members=%d", pool.source, count)
+		} else if count%32 == 0 {
+			log.G(context.Background()).Infof("rootfs pool building source=%s members=%d/%d", pool.source, count, pool.target)
+		}
+		time.Sleep(rootfsPoolBuildStagger)
+	}
+}
+
+// rootfsPoolFlusher batches the durability of adoptions: after the first
+// signal it waits out the debounce window and issues a single fsync of the
+// origin directory, which flushes every rename inside the window at once.
+func (m *XfsCow) rootfsPoolFlusher(pool *rootfsShadowPool) {
+	for {
+		select {
+		case <-pool.flushCh:
+		case <-pool.done:
+			return
+		}
+		timer := time.NewTimer(rootfsPoolFlushDelay)
+	drain:
+		for {
+			select {
+			case <-pool.flushCh:
+			case <-timer.C:
+				break drain
+			case <-pool.done:
+				timer.Stop()
+				return
+			}
+		}
+		if err := m.engine.FsyncSnapshotDir(pool.source); err != nil {
+			log.G(context.Background()).Warnf("rootfs pool flush fsync source=%s err=%v", pool.source, err)
+		}
+	}
+}
+
+// adoptFromRootfsPool hands a pre-derived member to a sandbox by renaming
+// it to the sandbox rootfs name. The third return value reports whether
+// this path decided the outcome (volume or terminal error); false means
+// the caller must fall back to the direct derive.
+func (m *XfsCow) adoptFromRootfsPool(ctx context.Context, templateSource, sandboxID string, gen uint32, desiredSizeBytes uint64) (*cowVolume, error, bool) {
+	pool := m.rootfsPoolFor(templateSource)
+	if pool == nil {
+		return nil, nil, false
+	}
+	pool.mu.Lock()
+	if pool.closed || len(pool.available) == 0 {
+		pool.mu.Unlock()
+		return nil, nil, false
+	}
+	member := pool.available[len(pool.available)-1]
+	pool.available = pool.available[:len(pool.available)-1]
+	delete(pool.present, member)
+	remaining := len(pool.available)
+	pool.mu.Unlock()
+
+	snapshotName := fmt.Sprintf("sb-%s-rootfs-gen%d", sandboxID, gen)
+	devPath, err := m.engine.RenameSnapshot(member, snapshotName)
+	if err != nil {
+		// Miss: fall back to the direct derive. The popped member is not
+		// requeued; the builder reproduces the slot.
+		log.G(ctx).Warnf("rootfs pool adopt fallback member=%s sandbox=%s err=%v", member, sandboxID, err)
+		return nil, nil, false
+	}
+	resized, err := m.resizeSnapshotIfTooSmall(snapshotName, desiredSizeBytes)
+	if err != nil {
+		return nil, err, true
+	}
+	if resized {
+		if devPath, err = m.ResolveDevPath(ctx, snapshotName, cowKindSnapshot); err != nil {
+			return nil, err, true
+		}
+	}
+	select {
+	case pool.flushCh <- struct{}{}:
+	default:
+	}
+	m.kickRootfsPoolFill(pool)
+	log.G(ctx).Infof("rootfs pool adopt sandbox=%s member=%s remaining=%d", sandboxID, member, remaining)
+	return newCowVolume(snapshotName, cowKindSnapshot, gen, devPath), nil, true
+}
+
+// dropRootfsPool removes the pool for templateSource (template teardown)
+// and best-effort deletes on-disk members, including orphans left by
+// previous process lives with larger targets.
+func (m *XfsCow) dropRootfsPool(templateSource string) {
+	rootfsPoolsMu.Lock()
+	pool, ok := rootfsPools[templateSource]
+	if ok {
+		delete(rootfsPools, templateSource)
+	}
+	rootfsPoolsMu.Unlock()
+	if pool != nil {
+		pool.mu.Lock()
+		pool.closed = true
+		pool.mu.Unlock()
+		close(pool.done)
+	}
+	sweep := rootfsPoolSweepLimit
+	if pool != nil && pool.target > sweep {
+		sweep = pool.target
+	}
+	for i := 0; i < sweep; i++ {
+		_ = m.engine.DeleteSnapshot(rootfsPoolMemberName(templateSource, i))
+	}
+}
