  var PALETTE = ['#c7000b', '#e8833a', '#2f6f9f', '#7048c8', '#0e9c8a', '#f2b542', '#8a8fd3', '#64748b'];
  var MUTED_C = '#71798a', INK2_C = '#3d4655', LINE_C = '#e6e9ee';
  var SPLIT_LINE = { lineStyle: { color: '#eef0f4', type: 'dashed' } };
  var TOOLTIP = {
    confine: true,
    backgroundColor: '#fff',
