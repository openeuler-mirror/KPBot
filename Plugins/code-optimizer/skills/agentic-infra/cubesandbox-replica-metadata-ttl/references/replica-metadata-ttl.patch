diff --git a/CubeMaster/pkg/templatecenter/ready_replica_ttl.go b/CubeMaster/pkg/templatecenter/ready_replica_ttl.go
new file mode 100644
index 0000000..abb350a
--- /dev/null
+++ b/CubeMaster/pkg/templatecenter/ready_replica_ttl.go
@@ -0,0 +1,160 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package templatecenter
+
+import (
+	"context"
+	"os"
+	"strings"
+	"sync"
+	"time"
+)
+
+const (
+	readyReplicaTTL     = time.Second
+	readyReplicaTTLKeys = 128
+	readyReplicaTTLRows = 64
+)
+
+var (
+	readyReplicaTTLEnabled = os.Getenv("CUBEMASTER_READY_REPLICA_TTL") == "1"
+	readyReplicaCache      = readyReplicaTTLCache{now: time.Now}
+)
+
+func resolveCachedReadyReplica(ctx context.Context, templateID, preferredNodeID string) (ReplicaStatus, error) {
+	replicas, err := readyReplicaCache.load(ctx, templateID, readReplicaMetadata)
+	if err != nil {
+		return ReplicaStatus{}, err
+	}
+	preferredNodeID = strings.TrimSpace(preferredNodeID)
+	for _, replica := range replicas {
+		if !isReplicaSchedulableNow(ctx, replica) {
+			continue
+		}
+		if preferredNodeID == "" || strings.TrimSpace(replica.NodeID) == preferredNodeID {
+			return replica, nil
+		}
+	}
+	return ReplicaStatus{}, ErrTemplateHasNoReadyReplica
+}
+
+func readReplicaMetadata(ctx context.Context, templateID string) ([]ReplicaStatus, error) {
+	rows, err := ListReplicas(ctx, templateID)
+	if err != nil {
+		return nil, err
+	}
+	metadata := make([]ReplicaStatus, 0, len(rows))
+	for _, row := range rows {
+		metadata = append(metadata, replicaModelToStatus(row))
+	}
+	return metadata, nil
+}
+
+type readyReplicaTTLEntry struct {
+	rows      []ReplicaStatus
+	expiresAt time.Time
+}
+
+// A process-wide epoch fences reads across committed local replica writes.
+// Slices hold ordered, value-only metadata and are read-only after publication.
+type readyReplicaTTLCache struct {
+	mu      sync.Mutex
+	epoch   uint64
+	entries map[string]readyReplicaTTLEntry
+	now     func() time.Time
+}
+
+func (c *readyReplicaTTLCache) load(ctx context.Context, templateID string,
+	query func(context.Context, string) ([]ReplicaStatus, error),
+) ([]ReplicaStatus, error) {
+	for attempt := 0; ; attempt++ {
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		c.mu.Lock()
+		started := c.now()
+		epoch := c.epoch
+		if row, ok := c.entries[templateID]; ok && started.Before(row.expiresAt) {
+			c.mu.Unlock()
+			return row.rows, nil
+		}
+		delete(c.entries, templateID)
+		c.mu.Unlock()
+
+		// Each miss reads independently. The lock is never held across SQL.
+		rows, err := query(ctx, templateID)
+		if err != nil {
+			return nil, err
+		}
+		if err := ctx.Err(); err != nil {
+			return nil, err
+		}
+		cacheable := len(rows) <= readyReplicaTTLRows && containsReadyReplica(rows)
+		c.mu.Lock()
+		if epoch != c.epoch {
+			c.mu.Unlock()
+			if attempt == 1 {
+				// Frequent writes should degrade to the original direct read.
+				return query(ctx, templateID)
+			}
+			continue
+		}
+		if cacheable {
+			c.publish(templateID, started.Add(readyReplicaTTL), rows)
+		}
+		c.mu.Unlock()
+		return rows, nil
+	}
+}
+
+// publish runs under mu. The TTL starts at query entry to avoid renewing the
+// lifetime of data from a slow query. Keep a valid entry from another miss.
+func (c *readyReplicaTTLCache) publish(key string, expiresAt time.Time, rows []ReplicaStatus) {
+	now := c.now()
+	if !now.Before(expiresAt) {
+		return
+	}
+	if entry, ok := c.entries[key]; ok && now.Before(entry.expiresAt) {
+		return
+	}
+	if len(c.entries) >= readyReplicaTTLKeys {
+		for key, entry := range c.entries {
+			if !now.Before(entry.expiresAt) {
+				delete(c.entries, key)
+			}
+		}
+		if len(c.entries) >= readyReplicaTTLKeys {
+			return
+		}
+	}
+	if c.entries == nil {
+		c.entries = make(map[string]readyReplicaTTLEntry)
+	}
+	c.entries[key] = readyReplicaTTLEntry{rows: rows, expiresAt: expiresAt}
+}
+
+func containsReadyReplica(rows []ReplicaStatus) bool {
+	for _, row := range rows {
+		if strings.TrimSpace(row.Status) == ReplicaStatusReady {
+			return true
+		}
+	}
+	return false
+}
+
+func invalidateReadyReplicaTTL() {
+	if !readyReplicaTTLEnabled {
+		return
+	}
+	readyReplicaCache.mu.Lock()
+	readyReplicaCache.epoch++
+	readyReplicaCache.entries = nil
+	readyReplicaCache.mu.Unlock()
+}
+
+func finishReadyReplicaWrite(err error) error {
+	if err == nil {
+		invalidateReadyReplicaTTL()
+	}
+	return err
+}
