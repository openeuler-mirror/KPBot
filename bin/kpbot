#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
PACKAGE_ROOT="$(dirname "$SCRIPT_DIR")"
INSTALL_SH="$PACKAGE_ROOT/install.sh"

VERSION=$(node -p "require('$PACKAGE_ROOT/package.json').version" 2>/dev/null || echo "unknown")

show_help() {
    cat << EOF
KPBot v$VERSION — 鲲鹏/ARM 高性能计算工具集

Usage: kpbot <command> [options]

Commands:
  install   [global|project] [claude|opencode] [path]   安装 skills 到目标工具
  uninstall [global|project] [claude|opencode] [path]   卸载已安装 skills
  memory    <subcommand> [options]                     优化经验记忆（OpenViking backend 入口）
  help                                                  显示此帮助

Examples:
  kpbot install global opencode        # 全局安装到 OpenCode
  kpbot install project claude         # 项目级安装到 Claude Code
  kpbot install project claude /path   # 项目级，指定路径
  kpbot uninstall global opencode      # 全局卸载

  kpbot memory backend --help          # 记忆 CLI 帮助（透传到 kpbot-memory）
  kpbot memory backend status --config <配置文件>   # 检查记忆后端状态

Memory 说明:
  backend 入口使用 uv 管理的独立 Python 环境；配置文件由用户/宿主提供并保持 0600；
  详细调用约定见 Plugins/memory/skills/kpbot-memory/SKILL.md
EOF
}

CMD="${1:-help}"
case "$CMD" in
    install)
        shift
        exec "$INSTALL_SH" "$@"
        ;;
    uninstall)
        shift
        exec "$PACKAGE_ROOT/bin/_uninstall.sh" "$@"
        ;;
    memory)
        shift
        MEMORY_CLI="$PACKAGE_ROOT/Plugins/memory/skills/kpbot-memory/scripts/kpbot-memory.py"
        if [ ! -f "$MEMORY_CLI" ]; then
            echo "kpbot memory: memory core not found at $MEMORY_CLI" >&2
            echo "Memory installation is incomplete; reinstall KPBot or see Plugins/memory/README.md." >&2
            exit 2
        fi
        if ! command -v python3 >/dev/null 2>&1; then
            echo "kpbot memory: python3 (>=3.10) is required" >&2
            exit 2
        fi
        exec python3 "$MEMORY_CLI" "$@"
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        echo "Unknown command: $CMD" >&2
        show_help
        exit 1
        ;;
esac
