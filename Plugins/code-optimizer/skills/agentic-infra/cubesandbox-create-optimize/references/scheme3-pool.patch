+    fn rename_snapshot(&self, old_name: &str, new_name: &str) -> CubecowResult<Snapshot> {
+        Self::validate_name(new_name, "snapshot")?;
+        // Hold the write lock across lookup + rename + index update so a
+        // concurrent create/delete of either name cannot interleave with
+        // the on-disk rename. POSIX rename(2) would silently replace an
+        // existing destination; the index check below is what protects
+        // the global-namespace invariant.
+        {
+            let mut idx = self
+                .name_index
+                .write()
+                .expect("reflink name_index lock poisoned");
+            let origin = match idx.get(old_name) {
+                Some(NameKind::Snapshot { origin_volume }) => origin_volume.clone(),
+                Some(NameKind::Volume) => {
+                    return Err(CubecowError::InvalidArg(format!(
+                        "'{old_name}' is a volume; rename_snapshot expects a snapshot"
+                    )));
+                }
+                None => {
+                    return Err(CubecowError::NotFound(format!(
+                        "snapshot '{old_name}'"
+                    )));
+                }
+            };
+            if idx.contains_key(new_name) {
+                return Err(CubecowError::AlreadyExists(format!(
+                    "name '{new_name}' already exists in reflink namespace"
+                )));
+            }
+            let old_path = self.snap_file(&origin, old_name);
+            let new_path = self.snap_file(&origin, new_name);
+            std::fs::rename(&old_path, &new_path).map_err(CubecowError::IoError)?;
+            idx.remove(old_name);
+            idx.insert(
+                new_name.to_string(),
+                NameKind::Snapshot {
+                    origin_volume: origin,
+                },
+            );
+        }
+        info!(
+            from = old_name,
+            to = new_name,
+            "reflink snapshot renamed (durability deferred to fsync_snapshot_dir)"
+        );
+        self.project_snapshot(new_name)
+    }
