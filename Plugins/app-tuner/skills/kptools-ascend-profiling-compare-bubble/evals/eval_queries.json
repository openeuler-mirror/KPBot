    { "id": "BUB-11", "prompt": "分析单份无栈 trace 的 P1/P2/P3 和模型结构", "should_trigger": false, "note": "routes to kptools-ascend-profiling-analysis-nostack" },
    { "id": "BUB-12", "prompt": "对比两份 trace 的算子种类、调用次数和 shape 分布", "should_trigger": false, "note": "routes to kptools-ascend-profiling-compare-opstats" },
    { "id": "BUB-13", "prompt": "帮我把推理服务的整体吞吐调高", "should_trigger": false, "note": "routes to kpbot-app-tuner" }
