index 5f2a69e07..5d2e23315 100644
--- a/util/bloom_impl.h
+++ b/util/bloom_impl.h
@@ -13,6 +13,13 @@
 
 #include <cmath>
 
+#if defined(__linux__) && defined(ROCKSDB_AUXV_GETAUXVAL_PRESENT)
+#include <sys/auxv.h>
+#if defined(__aarch64__)
+#include <asm/hwcap.h>
+#endif
+#endif
+
 #include "port/port.h"  // for PREFETCH
 #include "rocksdb/slice.h"
 #include "util/hash.h"
@@ -21,6 +28,10 @@
 #include <immintrin.h>
 #endif
 
+#if defined(HAVE_ARM_SVE2_BLOOM)
+#include <arm_sve.h>
+#endif
+
 namespace ROCKSDB_NAMESPACE {
 
 class BloomMath {
@@ -227,6 +238,60 @@ class FastLocalBloomImpl {
   static inline bool HashMayMatchPrepared(uint32_t h2, int num_probes,
                                           const char *data_at_cache_line) {
     uint32_t h = h2;
+#if defined(HAVE_ARM_SVE2_BLOOM)
+    // The SVE implementation below is laid out for exactly eight 32-bit
+    // lanes (256 bits). Cache the feature check so queries do not repeatedly
+    // read the auxiliary vector.
+    static const bool sve2_available = [] {
+#if defined(__linux__) && defined(__aarch64__) && \
+    defined(ROCKSDB_AUXV_GETAUXVAL_PRESENT) && defined(HWCAP2_SVE2)
+      return (getauxval(AT_HWCAP2) & HWCAP2_SVE2) != 0 && svcntw() == 8;
+#else
+      return false;
+#endif
+    }();
+    if (sve2_available) {
+      int rem_probes = num_probes;
+
+      static const uint32_t multipliers_arr[8] = {
+          0x00000001, 0x9e3779b9, 0xe35e67b1, 0x734297e9,
+          0x35fbe861, 0xdeb7c719, 0x448b211, 0x3459b749
+      };
+
+      svuint32_t multipliers = svld1_u32(svptrue_b32(), multipliers_arr);
+
+      while (rem_probes > 0) {
+        const uint32_t *data_as_uint32 = (const uint32_t *)data_at_cache_line;
+        svuint32_t lower = svld1_u32(svptrue_b32(), data_as_uint32);
+
+        int32_t probes_this_iter = (rem_probes < 8) ? rem_probes : 8;
+        svbool_t pg = svwhilelt_b32(0, probes_this_iter);
+        svuint32_t hash_vector = svdup_u32(h);
+        hash_vector = svmul_u32_z(pg, hash_vector, multipliers);
+        svuint32_t word_addresses = svlsr_x(pg, hash_vector, 28);
+
+        svuint32_t upper = svld1_vnum_u32(svptrue_b32(), data_as_uint32, 1);
+        svuint32x2_t all_value_vector = svcreate2(lower, upper);
+        svuint32_t value_vector = svtbl2_u32(all_value_vector, word_addresses);
+
+        svuint32_t bit_addresses = svlsl_x(pg, hash_vector, 4);
+        bit_addresses = svlsr_x(pg, bit_addresses, 27);
+        svuint32_t bit_mask = svlsl_u32_z(pg, svdup_u32(1), bit_addresses);
+
+        svuint32_t and_result = svand_u32_z(pg, value_vector, bit_mask);
+        svbool_t cmp_result = svcmpne_u32(pg, and_result, bit_mask);
+        if (svptest_any(pg, cmp_result)) {
+          return false;
+        }
+
+        if (rem_probes > 8) {
+          h *= 0xab25f4c1;
+        }
+        rem_probes -= probes_this_iter;
+      }
+      return true;
+    }
+#endif
 #ifdef HAVE_AVX2
     int rem_probes = num_probes;
 
diff --git a/util/bloom_impl_test.cc b/util/bloom_impl_test.cc
new file mode 100644
index 000000000..ebb889f39
--- /dev/null
+++ b/util/bloom_impl_test.cc
@@ -0,0 +1,171 @@
+//  Copyright (c) 2011-present, Facebook, Inc.  All rights reserved.
+//  This source code is licensed under both the GPLv2 (found in the
+//  COPYING file in the root directory) and Apache 2.0 License
+//  (found in the LICENSE.Apache file in the root directory).
+
+#include <array>
+#include <cstdint>
+
+#include "test_util/testharness.h"
+#include "util/bloom_impl.h"
+
+namespace ROCKSDB_NAMESPACE {
+namespace {
+
+constexpr uint32_t kGoldenRatio = 0x9e3779b9;
+constexpr size_t kCacheLineBytes = 64;
+constexpr size_t kCacheLineBits = kCacheLineBytes * 8;
+
+class UnalignedCacheLine {
+ public:
+  char* data() { return reinterpret_cast<char*>(storage_.data() + 1); }
+  const char* data() const {
+    return reinterpret_cast<const char*>(storage_.data() + 1);
+  }
+
+  void Fill(uint8_t value) { storage_.fill(value); }
+
+ private:
+  // The offset deliberately verifies the implementation's unaligned-load path.
+  std::array<uint8_t, kCacheLineBytes + 1> storage_{};
+};
+
+int ProbeBitPosition(uint32_t hash) {
+  return static_cast<int>(hash >> (32 - 9));
+}
+
+bool ScalarHashMayMatch(uint32_t hash, int num_probes, const char* data) {
+  for (int i = 0; i < num_probes; ++i, hash *= kGoldenRatio) {
+    const int bitpos = ProbeBitPosition(hash);
+    if ((static_cast<uint8_t>(data[bitpos >> 3]) &
+         (uint8_t{1} << (bitpos & 7))) == 0) {
+      return false;
+    }
+  }
+  return true;
+}
+
+uint32_t HashWithUniqueProbeBits(int num_probes) {
+  for (uint32_t candidate = 1;; candidate += kGoldenRatio) {
+    std::array<bool, kCacheLineBits> used{};
+    uint32_t hash = candidate;
+    bool unique = true;
+    for (int probe = 0; probe < num_probes; ++probe,
+             hash *= kGoldenRatio) {
+      const int bitpos = ProbeBitPosition(hash);
+      if (used[bitpos]) {
+        unique = false;
+        break;
+      }
+      used[bitpos] = true;
+    }
+    if (unique) {
+      return candidate;
+    }
+  }
+}
+
+void ClearProbeBit(uint32_t hash, int probe, char* data) {
+  while (probe-- > 0) {
+    hash *= kGoldenRatio;
+  }
+  const int bitpos = ProbeBitPosition(hash);
+  auto* bytes = reinterpret_cast<uint8_t*>(data);
+  bytes[bitpos >> 3] &= static_cast<uint8_t>(~(uint8_t{1} << (bitpos & 7)));
+}
+
+bool SVE2PathIsAvailable() {
+#if defined(HAVE_ARM_SVE2_BLOOM) && defined(__linux__) && \
+    defined(__aarch64__) && defined(ROCKSDB_AUXV_GETAUXVAL_PRESENT) && \
+    defined(HWCAP2_SVE2)
+  return (getauxval(AT_HWCAP2) & HWCAP2_SVE2) != 0 && svcntw() == 8;
+#else
+  return false;
+#endif
+}
+
+// Verifies that this process meets the SVE2 path's runtime prerequisites before
+// executing the functional checks that exercise HashMayMatchPrepared.
+TEST(FastLocalBloomImplTest, SVE2PathRuntimePrerequisites) {
+  if (!SVE2PathIsAvailable()) {
+    ROCKSDB_GTEST_SKIP("SVE2 with 256-bit vectors is unavailable");
+    return;
+  }
+  ASSERT_TRUE(SVE2PathIsAvailable());
+
+  UnalignedCacheLine cache_line;
+  cache_line.Fill(0);
+  constexpr int kNumProbes = 30;
+  const uint32_t hash = HashWithUniqueProbeBits(kNumProbes);
+  FastLocalBloomImpl::AddHashPrepared(hash, kNumProbes, cache_line.data());
+  ASSERT_TRUE(FastLocalBloomImpl::HashMayMatchPrepared(
+      hash, kNumProbes, cache_line.data()));
+}
+
+// Verifies that each SVE2 predicate width and every eight-lane chunk preserve
+// positive matches for all probe counts accepted by the Bloom format.
+TEST(FastLocalBloomImplTest, MatchesInsertedHashesForEveryProbeCount) {
+  for (int num_probes = 1; num_probes <= 30; ++num_probes) {
+    UnalignedCacheLine cache_line;
+    cache_line.Fill(0);
+    const uint32_t hash = HashWithUniqueProbeBits(num_probes);
+
+    FastLocalBloomImpl::AddHashPrepared(hash, num_probes, cache_line.data());
+
+    ASSERT_TRUE(ScalarHashMayMatch(hash, num_probes, cache_line.data()));
+    ASSERT_TRUE(FastLocalBloomImpl::HashMayMatchPrepared(
+        hash, num_probes, cache_line.data()))
+        << "num_probes=" << num_probes;
+  }
+}
+
+// Verifies that the vectorized word selection and bit-mask calculation agree
+// with an independent scalar implementation for varied Bloom data and hashes.
+TEST(FastLocalBloomImplTest, MatchesScalarReferenceForVariedData) {
+  constexpr std::array<uint32_t, 4> kHashes = {
+      0x00000001, 0x12345678, 0x89abcdef, 0xfedcba98
+  };
+
+  UnalignedCacheLine cache_line;
+  cache_line.Fill(0);
+  auto* bytes = reinterpret_cast<uint8_t*>(cache_line.data());
+  for (size_t i = 0; i < kCacheLineBytes; ++i) {
+    bytes[i] = static_cast<uint8_t>(i * 73 + 19);
+  }
+
+  for (uint32_t hash : kHashes) {
+    for (int num_probes = 1; num_probes <= 30; ++num_probes) {
+      ASSERT_EQ(ScalarHashMayMatch(hash, num_probes, cache_line.data()),
+                FastLocalBloomImpl::HashMayMatchPrepared(
+                    hash, num_probes, cache_line.data()))
+          << "hash=" << hash << ", num_probes=" << num_probes;
+    }
+  }
+}
+
+// Verifies that a missing bit in every SVE2 chunk is rejected, including the
+// final partial chunk after three full eight-lane chunks.
+TEST(FastLocalBloomImplTest, RejectsMissingProbeInEveryVectorChunk) {
+  constexpr int kNumProbes = 30;
+  const uint32_t hash = HashWithUniqueProbeBits(kNumProbes);
+
+  for (int missing_probe : {0, 8, 16, 24, 29}) {
+    UnalignedCacheLine cache_line;
+    cache_line.Fill(0);
+    FastLocalBloomImpl::AddHashPrepared(hash, kNumProbes, cache_line.data());
+    ClearProbeBit(hash, missing_probe, cache_line.data());
+
+    ASSERT_FALSE(ScalarHashMayMatch(hash, kNumProbes, cache_line.data()));
+    ASSERT_FALSE(FastLocalBloomImpl::HashMayMatchPrepared(
+        hash, kNumProbes, cache_line.data()))
+        << "missing_probe=" << missing_probe;
+  }
+}
+
+}  // namespace
+}  // namespace ROCKSDB_NAMESPACE
+
+int main(int argc, char** argv) {
+  ::testing::InitGoogleTest(&argc, argv);
+  return RUN_ALL_TESTS();
+}
