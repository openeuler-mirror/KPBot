    { "id": "BUB-06", "prompt": "分析单份采集的设备气泡，分成计算/通信/同步三类", "should_trigger": true },
    { "id": "BUB-07", "prompt": "哪些空闲窗口紧邻 hcom 通信算子，属于通信等待", "should_trigger": true },
