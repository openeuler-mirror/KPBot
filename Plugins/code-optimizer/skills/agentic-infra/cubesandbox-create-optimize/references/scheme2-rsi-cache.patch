+// skipLocalityDecisionTTL bounds how long the "can this template restore skip
+// the local-replica check" answer is memoized. The lookup is a point SELECT on
+// t_cube_snapshot that runs on every create; for an AppSnapshot template the
+// row does not exist at all, so the same failing query is repeated per create.
+// The memo is per templateID, short lived, and only stores answers derived
+// from a completed DB read (transient DB errors are never memorized).
+const skipLocalityDecisionTTL = 1 * time.Second
+
+type skipLocalityDecision struct {
+	skip     bool
+	expireAt time.Time
+}
+
+var (
+	skipLocalityMu    sync.Mutex
+	skipLocalityCache = make(map[string]skipLocalityDecision)
+)
+
+func loadSkipLocalityDecision(templateID string) (bool, bool) {
+	skipLocalityMu.Lock()
+	defer skipLocalityMu.Unlock()
+	decision, ok := skipLocalityCache[templateID]
+	if !ok {
+		return false, false
+	}
+	if time.Now().After(decision.expireAt) {
+		delete(skipLocalityCache, templateID)
+		return false, false
+	}
+	return decision.skip, true
+}
+
+func storeSkipLocalityDecision(templateID string, skip bool) {
+	now := time.Now()
+	skipLocalityMu.Lock()
+	if len(skipLocalityCache) > 1024 {
+		for k, v := range skipLocalityCache {
+			if now.After(v.expireAt) {
+				delete(skipLocalityCache, k)
+			}
+		}
+	}
+	skipLocalityCache[templateID] = skipLocalityDecision{skip: skip, expireAt: now.Add(skipLocalityDecisionTTL)}
+	skipLocalityMu.Unlock()
+}
+
+// resetSkipLocalityDecisionCache drops every memoized decision. Test helper.
+func resetSkipLocalityDecisionCache() {
+	skipLocalityMu.Lock()
+	skipLocalityCache = make(map[string]skipLocalityDecision)
+	skipLocalityMu.Unlock()
+}
+
 func skipTemplateLocalityReady(ctx context.Context, templateID string) bool {
