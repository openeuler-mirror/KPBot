    padding: [10, 14],
    textStyle: { color: '#171c26', fontSize: 12 },
    extraCssText: 'box-shadow:0 8px 24px rgba(23,28,38,.14);border-radius:10px;'
  };
  function gradH(c1, c2) {
    return { type: 'linear', x: 0, y: 0, x2: 1, y2: 0, colorStops: [{ offset: 0, color: c1 }, { offset: 1, color: c2 }] };
  }
  function gradV(c1, c2) {
    return { type: 'linear', x: 0, y: 0, x2: 0, y2: 1, colorStops: [{ offset: 0, color: c1 }, { offset: 1, color: c2 }] };
  }
  var fmt = function (v, n) { return Number(v).toFixed(n === undefined ? 2 : n); };
  var esc = function (t) {
    return String(t).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  };

  function mkTopKernels(rows) {
    rows = rows || [];
    var names = rows.map(function (r) { return r.kernel; }).reverse();
    var vals = rows.map(function (r) { return +(r.total_dur_us / 1000).toFixed(3); }).reverse();
    return {
      h: Math.max(200, rows.length * 24 + 56),
      opt: {
        animation: false,
        textStyle: { fontFamily: FONT },
        grid: { left: 8, right: 56, top: 8, bottom: 24, containLabel: true },
        tooltip: Object.assign({}, TOOLTIP, {
          formatter: function (p) {
            var r = rows[rows.length - 1 - p.dataIndex];
            if (!r) return '';
            return '<b>' + esc(r.kernel) + '</b><br/>count: ' + r.count +
              '<br/>total: ' + fmt(r.total_dur_us / 1000, 3) + ' ms' +
              '<br/>avg: ' + fmt(r.avg_dur_us / 1000, 3) + ' ms' +
              '<br/>max: ' + fmt(r.max_dur_us / 1000, 3) + ' ms' +
              '<br/>占比: ' + fmt(r.pct_of_kernel_time) + '%';
          }
        }),
        xAxis: {
          type: 'value', axisLine: { show: false }, axisTick: { show: false },
          axisLabel: { color: MUTED_C, fontSize: 11, formatter: function (v) { return v + ' ms'; } },
          splitLine: SPLIT_LINE
        },
        yAxis: {
          type: 'category', data: names,
          axisLine: { lineStyle: { color: LINE_C } }, axisTick: { show: false },
          axisLabel: { width: 320, overflow: 'truncate', color: INK2_C, fontSize: 11 }
        },
        series: [{
          type: 'bar', data: vals, barMaxWidth: 18,
          itemStyle: { borderRadius: [0, 4, 4, 0], color: gradH('#f2a49e', '#c7000b') },
          label: { show: true, position: 'right', fontSize: 10, color: MUTED_C, formatter: function (p) { return fmt(p.value, 1); } }
        }]
      }
    };
  }

  function mkTaskTypes(rows) {
    rows = rows || [];
    var total = rows.reduce(function (a, r) { return a + r.count; }, 0) || 1;
    return {
      h: 340,
      opt: {
        animation: false,
        textStyle: { fontFamily: FONT },
        color: PALETTE,
        tooltip: Object.assign({}, TOOLTIP, {
          formatter: function (p) {
            var r = rows[p.dataIndex];
            if (!r) return '';
            return '<b>' + esc(r.type) + '</b><br/>count: ' + r.count +
              '<br/>total: ' + fmt(r.total_dur_us / 1000, 1) + ' ms' +
              '<br/>占比: ' + fmt(100 * r.count / total) + '%';
          }
        }),
        title: {
          text: String(total), subtext: '事件',
          left: '50%', top: 'middle', textAlign: 'center',
          textStyle: { color: '#171c26', fontSize: 24, fontWeight: 700 },
          subtextStyle: { color: MUTED_C, fontSize: 11 }
        },
        legend: {
          orient: 'vertical', right: 8, bottom: 8, icon: 'roundRect',
          itemWidth: 11, itemHeight: 8, textStyle: { fontSize: 11, color: INK2_C }
        },
        series: [{
          type: 'pie', radius: ['44%', '68%'], center: ['50%', '50%'],
          data: rows.map(function (r) { return { name: r.type, value: r.count }; }),
          label: { show: false },
          itemStyle: { borderColor: '#fff', borderWidth: 2 },
          emphasis: { scaleSize: 6, itemStyle: { shadowBlur: 14, shadowColor: 'rgba(23,28,38,.22)' } }
        }]
      }
    };
  }

  function mkOverlap(tracks) {
    var rows = (tracks || []).slice().reverse();
    return {
      h: Math.max(180, rows.length * 34 + 56),
      opt: {
        animation: false,
        textStyle: { fontFamily: FONT },
        grid: { left: 8, right: 52, top: 8, bottom: 24, containLabel: true },
        tooltip: Object.assign({}, TOOLTIP, {
          formatter: function (p) {
            var r = rows[p.dataIndex];
            if (!r) return '';
            return '<b>' + esc(r.track) + '</b><br/>count: ' + r.count +
              '<br/>total: ' + fmt(r.total_us / 1000, 1) + ' ms' +
              '<br/>占比: ' + fmt(r.pct) + '%';
          }
        }),
        xAxis: {
          type: 'value', max: 100, axisLine: { show: false }, axisTick: { show: false },
          axisLabel: { color: MUTED_C, fontSize: 11, formatter: function (v) { return v + '%'; } },
          splitLine: SPLIT_LINE
        },
        yAxis: {
          type: 'category', data: rows.map(function (r) { return r.track; }),
          axisLine: { lineStyle: { color: LINE_C } }, axisTick: { show: false },
          axisLabel: { color: INK2_C, fontSize: 11 }
        },
        series: [{
          type: 'bar',
          data: rows.map(function (r) {
            return { value: +fmt(r.pct), itemStyle: { color: COLORS[r.track] || '#c7000b', borderRadius: [0, 4, 4, 0] } };
          }),
          barMaxWidth: 22,
          label: { show: true, position: 'right', fontSize: 10, color: MUTED_C, formatter: function (p) { return fmt(p.value, 1) + '%'; } }
        }]
      }
    };
  }

  function mkTimeline(tl) {
    var segs = tl || [];
    var FIXED = ['Computing', 'Communication', 'Communication(Not Overlapped)', 'Free'];
    var seen = {}, rest = [];
    segs.forEach(function (g) { if (!seen[g.track]) { seen[g.track] = 1; rest.push(g.track); } });
    var trackNames = FIXED.filter(function (t) { return seen[t]; })
      .concat(rest.filter(function (t) { return FIXED.indexOf(t) < 0; }));
    var tIdx = {};
    trackNames.forEach(function (t, i) { tIdx[t] = i; });
    var t0 = segs.length ? segs[0].ts : 0;
    segs.forEach(function (g) { if (g.ts < t0) t0 = g.ts; });
    var data = segs.map(function (g) {
      return [tIdx[g.track], +(((g.ts - t0) / 1000).toFixed(4)), +((g.dur / 1000).toFixed(4)), g.track];
    });
    var fmtDur = function (ms) { return ms >= 1 ? fmt(ms) + ' ms' : (ms * 1000).toFixed(1) + ' us'; };
    return {
      h: Math.max(220, trackNames.length * 54 + 70),
      opt: {
        animation: false,
        textStyle: { fontFamily: FONT },
        grid: { left: 8, right: 16, top: 10, bottom: 28, containLabel: true },
        tooltip: Object.assign({}, TOOLTIP, {
          formatter: function (p) {
            var d = p.data;
            return '<b>' + esc(d[3]) + '</b><br/>start: ' + fmtDur(d[1]) + '<br/>dur: ' + fmtDur(d[2]);
          }
        }),
        xAxis: {
          type: 'value', min: 0, axisLine: { lineStyle: { color: LINE_C } }, axisTick: { show: false },
          axisLabel: { color: MUTED_C, fontSize: 11, formatter: function (v) { return fmt(v, 0) + ' ms'; } },
          splitLine: SPLIT_LINE
        },
        yAxis: {
          type: 'category', data: trackNames,
          axisLine: { lineStyle: { color: LINE_C } }, axisTick: { show: false },
          axisLabel: { fontSize: 11, color: INK2_C }
        },
        series: [{
          type: 'custom',
          renderItem: function (params, api) {
            var yIdx = api.value(0);
            var ts = api.value(1);
            var dur = Math.max(api.value(2), 0.0002);
            var p0 = api.coord([ts, yIdx]);
            var p1 = api.coord([ts + dur, yIdx]);
            var hRect = api.size([0, 1])[1] * 0.62;
            return {
              type: 'rect',
              shape: { x: p0[0], y: p0[1] - hRect / 2, width: Math.max(p1[0] - p0[0], 1.2), height: hRect, r: 3 },
              style: { fill: COLORS[trackNames[yIdx]] || '#94a3b8' }
            };
          },
          data: data,
          encode: { x: [1, 2], y: 0 },
          clip: true
        }]
      }
    };
  }

  function mkMemory(mem) {
    mem = mem || {};
    var series = mem.series || [];
    var bm = mem.bucket_ms || 50;
    var n = 0;
    series.forEach(function (t) { n = Math.max(n, t.points.length); });
    var x = [];
    for (var i = 0; i < n; i++) x.push(+(i * bm).toFixed(1));
    return {
      h: 300,
      opt: {
        animation: false,
        textStyle: { fontFamily: FONT },
        legend: { top: 0, icon: 'roundRect', itemWidth: 11, itemHeight: 8, textStyle: { fontSize: 11, color: INK2_C } },
        tooltip: Object.assign({}, TOOLTIP, {
          trigger: 'axis',
          formatter: function (ps) {
            if (!ps || !ps.length) return '';
            var out = ['<b>t = ' + esc(ps[0].axisValue) + ' ms</b>'];
            ps.forEach(function (p) {
              var t = series[p.seriesIndex];
              out.push(p.marker + ' ' + esc(p.seriesName) + ': ' + fmt(p.value) + (t ? ' ' + t.unit : ''));
            });
            return out.join('<br/>');
          }
        }),
        xAxis: {
          type: 'category', data: x, boundaryGap: false,
          axisLine: { lineStyle: { color: LINE_C } }, axisTick: { show: false },
          axisLabel: { color: MUTED_C, fontSize: 11, formatter: function (v) { return v + ' ms'; } }
        },
        yAxis: [
          { type: 'value', name: 'us', nameTextStyle: { color: MUTED_C }, axisLabel: { color: MUTED_C, fontSize: 11 }, splitLine: SPLIT_LINE },
          { type: 'value', name: 'count', nameTextStyle: { color: MUTED_C }, axisLabel: { color: MUTED_C, fontSize: 11 }, splitLine: { show: false } }
        ],
        series: series.map(function (t, i) {
          var isCount = t.unit === 'count';
          var col = PALETTE[i % PALETTE.length];
          return {
            name: t.name, type: 'line', data: t.points, showSymbol: false,
            yAxisIndex: isCount ? 1 : 0, sampling: 'lttb',
            lineStyle: { width: 2, color: col }, itemStyle: { color: col },
            areaStyle: { opacity: 0.07, color: col }
          };
        })
      }
    };
  }

  function mkTTFTComp(rows) {
    rows = (rows || []).slice().reverse();
    return {
      h: Math.max(240, rows.length * 30 + 60),
      opt: {
        animation: false,
        textStyle: { fontFamily: FONT },
        grid: { left: 8, right: 56, top: 8, bottom: 24, containLabel: true },
        tooltip: Object.assign({}, TOOLTIP, {
          formatter: function (p) {
            var r = rows[p.dataIndex];
            if (!r) return '';
            return '<b>' + esc(r.name) + '</b><br/>count: ' + r.count +
              '<br/>mean: ' + fmt(r.mean_ms, 3) + ' ms<br/>p50: ' + fmt(r.p50_ms, 3) + ' ms' +
              '<br/>p95: ' + fmt(r.p95_ms, 3) + ' ms<br/>max: ' + fmt(r.max_ms, 3) + ' ms' +
              '<br/>均值占比: ' + fmt(r.pct) + '%';
          }
        }),
        xAxis: {
          type: 'value', axisLine: { show: false }, axisTick: { show: false },
          axisLabel: { color: MUTED_C, fontSize: 11, formatter: function (v) { return v + ' ms'; } },
          splitLine: SPLIT_LINE
        },
        yAxis: {
          type: 'category', data: rows.map(function (r) { return r.name; }),
          axisLine: { lineStyle: { color: LINE_C } }, axisTick: { show: false },
          axisLabel: { interval: 0, width: 280, overflow: 'truncate', fontSize: 12, color: INK2_C }
        },
        series: [{
          type: 'bar', barMaxWidth: 26,
          data: rows.map(function (r, i) {
            return {
              value: +fmt(r.mean_ms, 3),
              itemStyle: { color: PALETTE[(rows.length - 1 - i) % PALETTE.length], borderRadius: [0, 4, 4, 0] }
            };
          }),
          label: { show: true, position: 'right', fontSize: 10, color: MUTED_C, formatter: function (p) { return fmt(p.value, 1); } }
        }]
      }
    };
  }

  function mkCommStack(rows) {
    rows = rows || [];
    var segs = [
      ['wait_ms', '等待', '#e8833a'],
      ['sync_ms', '同步', '#7048c8'],
      ['idle_ms', '空闲', '#a8b0bd'],
      ['transit_ms', '传输', '#c7000b']
    ];
    return {
      h: Math.max(220, rows.length * 30 + 70),
      opt: {
        animation: false,
        textStyle: { fontFamily: FONT },
        legend: { top: 0, icon: 'roundRect', itemWidth: 11, itemHeight: 8, textStyle: { fontSize: 11, color: INK2_C } },
        tooltip: Object.assign({}, TOOLTIP, {
          trigger: 'axis', axisPointer: { type: 'shadow' },
          formatter: function (ps) {
            if (!ps || !ps.length) return '';
            var r = rows[rows.length - 1 - ps[0].dataIndex];
            if (!r) return '';
            var out = ['<b>' + esc(r.op) + '</b>'];
            ps.forEach(function (p) {
              out.push(p.marker + ' ' + p.seriesName + ': ' + fmt(p.value) + ' ms');
            });
            return out.join('<br/>');
          }
        }),
        grid: { left: 8, right: 44, top: 30, bottom: 24, containLabel: true },
        xAxis: {
          type: 'value', axisLine: { show: false }, axisTick: { show: false },
          axisLabel: { color: MUTED_C, fontSize: 11, formatter: function (v) { return v + ' ms'; } },
          splitLine: SPLIT_LINE
        },
        yAxis: {
          type: 'category', data: rows.map(function (r) { return r.op; }).reverse(),
          axisLine: { lineStyle: { color: LINE_C } }, axisTick: { show: false },
          axisLabel: { width: 280, overflow: 'truncate', color: INK2_C, fontSize: 11 }
        },
        series: segs.map(function (s, i) {
          return {
            name: s[1], type: 'bar', stack: 'comm', barMaxWidth: 18,
            itemStyle: { color: s[2], borderRadius: i === segs.length - 1 ? [0, 4, 4, 0] : 0 },
            data: rows.map(function (r) { return +fmt(r[s[0]], 3); }).reverse()
          };
        })
      }
    };
  }

  var BUILDERS = [
    { id: 'chart-top-kernels-', build: function (r) { return mkTopKernels(r.top_kernels); } },
    { id: 'chart-task-types-', build: function (r) { return mkTaskTypes(r.task_types); } },
    { id: 'chart-overlap-', build: function (r) { return mkOverlap(r.overlap); } },
    { id: 'chart-overlap-timeline-', build: function (r) { return mkTimeline(r.overlap_timeline); } },
    { id: 'chart-memory-', build: function (r) { return mkMemory(r.memory); } },
    { id: 'chart-comm-stack-', build: function (r) { return mkCommStack(r.comm_stack); } },
    { id: 'chart-ttft-comp-', build: function (r) { return mkTTFTComp(r.ttft_comp); } }
  ];

  var charts = {};
  var inited = {};

  var MACHINE_BUILDERS = [
    { id: 'chart-ttft-comp-m', build: function (m) { return mkTTFTComp(m.ttft_comp); } },
    { id: 'chart-comm-stack-m', build: function (m) { return mkCommStack(m.comm_stack); } }
  ];
  var machineCharts = [];
  var machineInited = {};

  function initMachine(k) {
    if (machineInited[k]) return;
    machineInited[k] = true;
    var m = (DATA.machines || [])[k];
    if (!m) return;
    MACHINE_BUILDERS.forEach(function (b) {
      var el = document.getElementById(b.id + k);
      if (!el) return;
      var built = b.build(m);
      if (!built) return;
      var c = echarts.init(el, null, { renderer: 'canvas', height: built.h });
      c.setOption(built.opt);
      machineCharts.push(c);
    });
  }

  function initVisibleMachines() {
    var g = document.querySelector('.mgroup:not([hidden])');
    var m = g && /^mgroup-(\d+)$/.exec(g.id || '');
    if (m) initMachine(+m[1]);
  }

  function initPane(i) {
    if (inited[i]) return;
    inited[i] = true;
    var r = (DATA.runs || [])[i];
    if (!r) return;
    charts[i] = [];
    BUILDERS.forEach(function (b) {
      var el = document.getElementById(b.id + i);
      if (!el) return;
      var built = b.build(r);
      if (!built) return;
      var c = echarts.init(el, null, { renderer: 'canvas', height: built.h });
      c.setOption(built.opt);
      charts[i].push(c);
    });
  }

  function setupScrollSpy() {
    var ticking = false;
    function update() {
      ticking = false;
      var pane = document.querySelector('.mgroup:not([hidden]) .pane:not([hidden])');
      if (!pane) return;
      var nav = pane.querySelector('.pane-nav');
      if (!nav) return;
      var chips = Array.prototype.slice.call(nav.querySelectorAll('a.chip'));
      if (!chips.length) return;
      var firstSec = document.getElementById((chips[0].getAttribute('href') || '').slice(1));
      var margin = firstSec ? (parseFloat(getComputedStyle(firstSec).scrollMarginTop) || 84) : 84;
      var threshold = Math.max(nav.getBoundingClientRect().bottom + 12, margin + 8);
      var current = null;
      chips.forEach(function (a) {
        var id = (a.getAttribute('href') || '').slice(1);
        var sec = document.getElementById(id);
        if (sec && sec.getBoundingClientRect().top <= threshold) current = a;
      });
      if (window.pageYOffset + window.innerHeight >= document.documentElement.scrollHeight - 60) {
        current = chips[chips.length - 1];
      }
      chips.forEach(function (a) { a.classList.toggle('active', a === current); });
    }
    window.addEventListener('scroll', function () {
      if (!ticking) { ticking = true; window.requestAnimationFrame(update); }
    }, { passive: true });
    update();
  }

  function setupBackToTop() {
    var btt = document.getElementById('back-to-top');
    if (!btt) return;
    window.addEventListener('scroll', function () {
      btt.classList.toggle('show', window.pageYOffset > 480);
    }, { passive: true });
    btt.addEventListener('click', function () {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  function initVisiblePanes() {
    Array.prototype.slice.call(
      document.querySelectorAll('.mgroup:not([hidden]) .pane:not([hidden])')
    ).forEach(function (p) {
      var m = /^pane-(\d+)$/.exec(p.id || '');
      if (m) initPane(+m[1]);
    });
  }

  function boot() {
    initVisibleMachines();
    var mtabs = Array.prototype.slice.call(document.querySelectorAll('.tab[data-mgroup]'));
    mtabs.forEach(function (t) {
      t.addEventListener('click', function () {
        mtabs.forEach(function (x) { x.classList.remove('active'); });
        t.classList.add('active');
        var gid = t.getAttribute('data-mgroup');
        Array.prototype.slice.call(document.querySelectorAll('.mgroup')).forEach(function (g) {
          g.hidden = (g.id !== 'mgroup-' + gid);
        });
        initVisibleMachines();
        initVisiblePanes();
      });
    });
    var rtabs = Array.prototype.slice.call(document.querySelectorAll('.tab[data-pane]'));
    rtabs.forEach(function (t) {
      t.addEventListener('click', function () {
        Array.prototype.slice.call(t.parentNode.querySelectorAll('.tab')).forEach(function (x) {
          x.classList.remove('active');
        });
        t.classList.add('active');
        var target = t.getAttribute('data-pane');
        var group = t.closest('.mgroup') || document;
        Array.prototype.slice.call(group.querySelectorAll('.pane.rpane')).forEach(function (p) {
          p.hidden = (p.id !== target);
        });
        var m = /^pane-(\d+)$/.exec(target || '');
        if (m) initPane(+m[1]);
      });
    });
    initVisiblePanes();
    window.addEventListener('resize', function () {
      Object.keys(charts).forEach(function (k) {
        (charts[k] || []).forEach(function (c) { c.resize(); });
      });
      machineCharts.forEach(function (c) { c.resize(); });
    });
    setupScrollSpy();
    setupBackToTop();
  }

  window.REPORT_CHARTS = {
    mkTopKernels: mkTopKernels, mkTaskTypes: mkTaskTypes, mkOverlap: mkOverlap,
    mkTimeline: mkTimeline, mkMemory: mkMemory, mkTTFTComp: mkTTFTComp,
    mkCommStack: mkCommStack, DATA: DATA
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
})();
</script>
</body>
</html>
