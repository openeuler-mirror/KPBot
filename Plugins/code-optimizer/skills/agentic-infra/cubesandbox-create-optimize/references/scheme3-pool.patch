+/// Rename a snapshot in place (metadata-only; keeps origin volume and
+/// device path, only the name changes). The new device path is written to
+/// `out_device_path` (owned C string, caller frees with
+/// `cubecow_free_string`). Optional, can be NULL.
+///
+/// The rename is NOT fsynced by this call; batch durability with
+/// `cubecow_fsync_snapshot_dir`.
+///
+/// # Returns
+/// 0 on success, negative error code on failure.
+#[no_mangle]
+pub extern "C" fn cubecow_rename_snapshot(
+    engine: *mut std::ffi::c_void,
+    old_name: *const c_char,
