# 在顶层配置结束后修改明确指定的 target，不污染第三方编译参数。
cmake_minimum_required(VERSION 3.24)
function(kpbot_apply_pgo)
  foreach(t IN LISTS PGO_TARGETS)
    if(NOT TARGET "${t}")
      message(FATAL_ERROR "PGO target missing: ${t}")
    endif()
    get_target_property(kind "${t}" TYPE)
    if(kind STREQUAL "INTERFACE_LIBRARY" OR kind STREQUAL "IMPORTED_LIBRARY")
      message(FATAL_ERROR "PGO requires compiled target: ${t}")
    endif()
    if(PGO_PHASE STREQUAL "G")
      target_compile_options("${t}" PRIVATE "-fprofile-generate=${PGO_PROFILE_DIR}")
      if(PGO_THREADED)
        target_compile_options("${t}" PRIVATE "-fprofile-update=atomic")
      endif()
    elseif(PGO_PHASE STREQUAL "P")
      target_compile_options("${t}" PRIVATE "-fprofile-use=${PGO_PROFILE_DIR}" "-Werror=missing-profile" "-Werror=coverage-mismatch")
    elseif(NOT PGO_PHASE STREQUAL "B")
      message(FATAL_ERROR "Invalid PGO_PHASE")
    endif()
  endforeach()
  foreach(t IN LISTS PGO_LINK_TARGETS)
    if(NOT TARGET "${t}")
      message(FATAL_ERROR "PGO link target missing: ${t}")
    endif()
    get_target_property(kind "${t}" TYPE)
    if(NOT kind MATCHES "^(EXECUTABLE|SHARED_LIBRARY|MODULE_LIBRARY)$")
      message(FATAL_ERROR "PGO_LINK_TARGETS must be final link targets: ${t}")
    endif()
    target_link_options("${t}" PRIVATE "-Wl,-Map=${CMAKE_BINARY_DIR}/pgo-${t}.map")
    if(PGO_PHASE STREQUAL "G")
      target_link_options("${t}" PRIVATE "-fprofile-generate=${PGO_PROFILE_DIR}")
    elseif(PGO_PHASE STREQUAL "P")
      target_link_options("${t}" PRIVATE "-fprofile-use=${PGO_PROFILE_DIR}")
    endif()
  endforeach()
endfunction()
cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL kpbot_apply_pgo)
