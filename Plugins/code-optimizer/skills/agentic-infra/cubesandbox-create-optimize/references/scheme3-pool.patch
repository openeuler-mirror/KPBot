+// RenameSnapshot renames a snapshot in place. The snapshot keeps its
+// origin volume, size and device path; only the name changes. The rename
+// is not fsynced by this call - batch durability with FsyncSnapshotDir.
+func (e *Engine) RenameSnapshot(oldName, newName string) (string, error) {
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+
+	ptr, err := e.openHandle()
+	if err != nil {
+		return "", err
+	}
+	defer e.mu.RUnlock()
+
+	cOldName := C.CString(oldName)
+	defer C.free(unsafe.Pointer(cOldName))
+	cNewName := C.CString(newName)
+	defer C.free(unsafe.Pointer(cNewName))
+
+	var cDevicePath *C.char
+	rc := C.cubecow_rename_snapshot_go(C.CubecowEngineHandle(ptr), cOldName, cNewName, &cDevicePath)
+	if rc != 0 {
+		return "", makeError(rc)
+	}
+	return takeCString(cDevicePath), nil
+}
+
+// FsyncSnapshotDir best-effort fsyncs the directory that holds name
+// (resolved through its origin volume), flushing every pending rename
+// in that directory at once.
+func (e *Engine) FsyncSnapshotDir(name string) error {
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+
+	ptr, err := e.openHandle()
+	if err != nil {
+		return err
+	}
+	defer e.mu.RUnlock()
+
+	cName := C.CString(name)
+	defer C.free(unsafe.Pointer(cName))
+
+	rc := C.cubecow_fsync_snapshot_dir_go(C.CubecowEngineHandle(ptr), cName)
+	if rc != 0 {
+		return makeError(rc)
+	}
+	return nil
+}
